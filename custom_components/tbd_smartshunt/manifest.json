{
  "domain": "tbd_smartshunt",
  "name": "TBD Smartshunt",
  "codeowners": [
    "@mrbrito"
  ],
  "config_flow": true,
  "documentation": "https://github.com/mrbrito/ha-tbd-smartshunt",
  "integration_type": "device",
  "iot_class": "local_polling",
  "bluetooth": [
    {
      "local_name": "TBDsmartshunt*",
      "connectable": true
    },
    {
      "local_name": "TBDSMARTSHUNT*",
      "connectable": true
    }
  ],
  "dependencies": [
    "bluetooth"
  ],
  "requirements": [
    "bleak-retry-connector>=3.0.0"
  ],
  "version": "1.0.2"
}
